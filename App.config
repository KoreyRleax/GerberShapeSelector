<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
        <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
            <section name="GerberParserSmartV4._0.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
        </sectionGroup>
    </configSections>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    <appSettings>
        <!-- 视图缩放上限：世界单位 → 屏幕像素 的比例（1.0 = 1:1）。控件库默认 500。
             小板上铺满大画布时很容易撞到它 —— 例：Broad\q02578f045a00 只有 8.7 × 5.2 mm，
             在 1600×900 画布上 FitToWindow 之后就有 150 左右，放大三五下就到顶。
             可按需调大（如 1000）。⚠ 缺失 / 非数字 / ≤0 一律**忽略**，保持控件库默认
             （不会把上限误设成 0 而让画面卡死在某一级）。改完需**重启程序**。
             ⚠ 要持久生效就改这份 App.config（编译时会生成 exe 旁的 exe.config）；
             直接改 exe 旁的 exe.config 只对当前这份 exe 有效，**下次编译会被覆盖**。 -->
        <add key="ViewMaxScale" value="500" />
    </appSettings>
    <userSettings>
        <GerberParserSmartV4._0.Properties.Settings>
            <setting name="SelectedCircleColor" serializeAs="String">
                <value>white</value>
            </setting>
            <setting name="HeaderH2Color" serializeAs="String">
                <value>yellow</value>
            </setting>
            <setting name="HeaderH3Color" serializeAs="String">
                <value>green</value>
            </setting>
            <setting name="DefaultProjectRootPath" serializeAs="String">
                <value>Broad</value>
            </setting>
        </GerberParserSmartV4._0.Properties.Settings>
    </userSettings>
</configuration>